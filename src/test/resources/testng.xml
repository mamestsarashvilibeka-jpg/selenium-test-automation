<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium Automation Suite" verbose="1" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>

    <!-- Smoke Tests -->
    <test name="Smoke Tests" group-by-instances="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.LoginTest">
                <methods>
                    <include name="testSuccessfulLogin"/>
                </methods>
            </class>
            <class name="com.automation.tests.InventoryTest">
                <methods>
                    <include name="testProductsDisplayed"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Full Regression -->
    <test name="Regression Tests" group-by-instances="true">
        <classes>
            <class name="com.automation.tests.LoginTest"/>
            <class name="com.automation.tests.InventoryTest"/>
            <class name="com.automation.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
